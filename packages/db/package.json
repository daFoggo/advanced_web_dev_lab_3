{
  "name": "@workspace/db",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "neon:generate": "drizzle-kit generate",
    "neon:migrate": "node --env-file=../../apps/studio/.env.local ./node_modules/drizzle-kit/bin.cjs migrate",
    "neon:seed": "node --env-file=../../apps/studio/.env.local scripts/seed.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "pg": "8.23.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10",
    "globals": "^17.13.0",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "exports": {
    "./neon": "./src/neon/client.ts",
    "./neon/schema": "./src/neon/schema.ts"
  }
}
